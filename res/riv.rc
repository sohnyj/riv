// Icon id 1 is shared with the window class. Version info and the manifest
// are appended by the build script.
1 ICON "riv.ico"

#include "resource.h"

IDD_OPTIONS DIALOGEX 0, 0, 320, 251
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_OPTIONS_TAB, "SysTabControl32", WS_TABSTOP, 7, 7, 306, 216
    PUSHBUTTON "Restore defaults", IDC_RESTORE_DEFAULTS, 7, 230, 70, 14
    DEFPUSHBUTTON "OK", 1, 155, 230, 50, 14
    PUSHBUTTON "Cancel", 2, 209, 230, 50, 14
    PUSHBUTTON "Apply", IDC_APPLY, 263, 230, 50, 14
END

IDD_PAGE_WINDOW DIALOGEX 0, 0, 292, 194
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Titlebar text:", -1, 12, 14, 80, 8
    COMBOBOX IDC_WINDOW_TITLEBAR_MODE, 108, 11, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Background color", IDC_WINDOW_BGCOLOR_ENABLED, 12, 36, 80, 10
    CONTROL "", IDC_WINDOW_BGCOLOR_BUTTON, "Button", BS_OWNERDRAW | WS_TABSTOP, 108, 34, 50, 14
    AUTOCHECKBOX "Remember window size and position", IDC_WINDOW_SAVE_POSITION, 12, 58, 260, 10
    AUTOCHECKBOX "Ctrl+Drag to move window", IDC_WINDOW_CTRL_DRAG, 12, 72, 260, 10
    AUTOCHECKBOX "Hide cursor when idle in fullscreen", IDC_WINDOW_HIDE_CURSOR_FULLSCREEN, 12, 86, 260, 10
END

IDD_PAGE_IMAGE DIALOGEX 0, 0, 292, 194
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Fit image to:", -1, 12, 14, 80, 8
    COMBOBOX IDC_IMAGE_FITMODE, 108, 11, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Scaling:", -1, 12, 36, 80, 8
    COMBOBOX IDC_IMAGE_SCALING, 108, 33, 90, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Dither:", -1, 12, 58, 80, 8
    COMBOBOX IDC_IMAGE_DITHER, 108, 55, 90, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Preloading:", -1, 12, 80, 80, 8
    COMBOBOX IDC_IMAGE_PRELOADING, 108, 77, 90, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Zoom step:", -1, 12, 102, 80, 8
    EDITTEXT IDC_IMAGE_ZOOM_STEP_EDIT, 108, 99, 40, 13, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "", IDC_IMAGE_ZOOM_STEP_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 11, 13
    LTEXT "%", -1, 152, 102, 12, 8
    AUTOCHECKBOX "Zoom toward cursor", IDC_IMAGE_CURSOR_ZOOM, 12, 122, 260, 10
    AUTOCHECKBOX "Fractional wheel zoom", IDC_IMAGE_FRACTIONAL_WHEEL_ZOOM, 12, 136, 260, 10
END

IDD_PAGE_MISC DIALOGEX 0, 0, 292, 194
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Sort files by:", -1, 12, 14, 80, 8
    COMBOBOX IDC_MISC_SORT, 108, 11, 90, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTORADIOBUTTON "Ascending", IDC_MISC_ASCENDING, 108, 30, 60, 10, WS_GROUP
    AUTORADIOBUTTON "Descending", IDC_MISC_DESCENDING, 172, 30, 60, 10
    AUTOCHECKBOX "Loop within folder", IDC_MISC_LOOP_WITHIN_FOLDER, 12, 46, 260, 10, WS_GROUP
    LTEXT "Slideshow direction:", -1, 12, 64, 80, 8
    COMBOBOX IDC_MISC_SLIDESHOW_DIRECTION, 108, 61, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Slideshow interval:", -1, 12, 82, 80, 8
    EDITTEXT IDC_MISC_SLIDESHOW_INTERVAL_EDIT, 108, 79, 40, 13, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "", IDC_MISC_SLIDESHOW_INTERVAL_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 11, 13
    LTEXT "seconds", -1, 152, 82, 30, 8
    LTEXT "After deletion:", -1, 12, 100, 80, 8
    COMBOBOX IDC_MISC_AFTER_DELETE, 108, 97, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Ask before deleting files", IDC_MISC_ASK_DELETE, 12, 116, 260, 10
    AUTOCHECKBOX "Detect format by content", IDC_MISC_CONTENT_DETECTION, 12, 130, 260, 10
    AUTOCHECKBOX "Remember recent files", IDC_MISC_REMEMBER_RECENTS, 12, 144, 260, 10
    AUTOCHECKBOX "Skip hidden files", IDC_MISC_SKIP_HIDDEN, 12, 158, 260, 10
END

IDD_PAGE_SHORTCUTS DIALOGEX 0, 0, 292, 194
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "Reset to defaults", IDC_SHORTCUTS_RESET, 7, 7, 70, 14
    PUSHBUTTON "Clear all", IDC_SHORTCUTS_CLEAR_ALL, 235, 7, 50, 14
    CONTROL "", IDC_SHORTCUTS_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 26, 278, 161
END

IDD_PAGE_ASSOCIATION DIALOGEX 0, 0, 292, 194
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "Select all", IDC_ASSOC_SELECT_ALL, 7, 7, 60, 14
    PUSHBUTTON "Select none", IDC_ASSOC_SELECT_NONE, 225, 7, 60, 14
    CONTROL "", IDC_ASSOC_TREE, "SysTreeView32", TVS_HASBUTTONS | TVS_LINESATROOT | TVS_DISABLEDRAGDROP | TVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 26, 278, 161
END

IDD_PAGE_STARTMENU DIALOGEX 0, 0, 292, 194
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    AUTOCHECKBOX "Start menu shortcut", IDC_STARTMENU_SHORTCUT, 12, 12, 260, 10
END

IDD_CAPTURE_KEYBOARD DIALOGEX 0, 0, 220, 123
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Modify shortcuts"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Press a key combination to add it:", -1, 7, 9, 200, 8
    CONTROL "", IDC_CAPTURE_KEY_FIELD, "RivKeyCapture", WS_TABSTOP | WS_BORDER, 7, 20, 206, 14
    LISTBOX IDC_CAPTURE_KEY_LIST, 7, 41, 206, 54, LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Clear", IDC_CAPTURE_KEY_CLEAR, 7, 102, 50, 14
    DEFPUSHBUTTON "OK", 1, 109, 102, 50, 14
    PUSHBUTTON "Cancel", 2, 163, 102, 50, 14
END

IDD_CAPTURE_MOUSE DIALOGEX 0, 0, 220, 74
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Modify shortcuts"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Click in the field below to record a binding. Wheel, double-click and held modifiers are captured; right-click is reserved.", -1, 7, 9, 206, 17
    CONTROL "", IDC_CAPTURE_MOUSE_FIELD, "RivMouseCapture", WS_TABSTOP | WS_BORDER, 7, 30, 206, 16
    PUSHBUTTON "Clear", IDC_CAPTURE_MOUSE_CLEAR, 7, 53, 50, 14
    DEFPUSHBUTTON "OK", 1, 109, 53, 50, 14
    PUSHBUTTON "Cancel", 2, 163, 53, 50, 14
END

IDD_RENAME DIALOGEX 0, 0, 220, 48
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_TEXT_INPUT, 7, 7, 206, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", 1, 109, 27, 50, 14
    PUSHBUTTON "Cancel", 2, 163, 27, 50, 14
END

IDD_OPEN_URL DIALOGEX 0, 0, 300, 48
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Open URL"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_TEXT_INPUT, 7, 7, 286, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", 1, 189, 27, 50, 14
    PUSHBUTTON "Cancel", 2, 243, 27, 50, 14
END

IDD_PAGE_ABOUT DIALOGEX 0, 0, 292, 194
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Lucida Console"
BEGIN
    CTEXT "riv", IDC_ABOUT_TITLE, 0, 48, 292, 38
    CTEXT "", IDC_ABOUT_VERSION, 0, 90, 292, 14
    CTEXT "Built with Rust (x86-64-v3)", IDC_ABOUT_BUILD, 0, 112, 292, 10
    CONTROL "Source code available under GPLv3 on <a href=""https://github.com/sohnyj/riv"">GitHub</a>", IDC_ABOUT_LINK, "SysLink", WS_TABSTOP, 0, 126, 292, 10
END
